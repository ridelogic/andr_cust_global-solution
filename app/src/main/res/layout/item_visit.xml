<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_card"
    android:orientation="vertical"
    android:padding="@dimen/category_card_padding">

    <TextView
        android:id="@+id/visit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/login_subtitle_text_size"
        tools:text="Visit #1 · Completed" />

    <TextView
        android:id="@+id/visit_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/category_description_text_size"
        android:visibility="gone"
        tools:text="21 Sep 2026, 09:00 AM – 10:30 AM"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/visit_diagnosis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/category_description_text_size"
        android:visibility="gone"
        tools:text="Diagnosis: Compressor fault"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/visit_work_performed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/category_description_text_size"
        android:visibility="gone"
        tools:text="Work Performed: Replaced compressor"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/visit_attachments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/category_description_text_size"
        android:visibility="gone"
        tools:text="2 attachment(s)"
        tools:visibility="visible" />

</LinearLayout>
