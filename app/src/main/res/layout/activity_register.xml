<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.register.RegisterActivity">

    <View
        android:id="@+id/header_background"
        android:layout_width="0dp"
        android:layout_height="@dimen/login_header_height"
        android:background="@color/login_header_navy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="@dimen/login_back_button_size"
        android:layout_height="@dimen/login_back_button_size"
        android:layout_marginStart="@dimen/login_content_horizontal_margin"
        android:layout_marginTop="@dimen/login_content_horizontal_margin"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/register_logo"
        android:layout_width="@dimen/login_header_logo_size"
        android:layout_height="@dimen/login_header_logo_size"
        android:contentDescription="@string/splash_app_name"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintBottom_toBottomOf="@id/header_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/header_background" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/login_card_top_offset"
        android:background="@drawable/bg_login_card_top"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/login_content_horizontal_margin"
            android:paddingTop="@dimen/login_card_content_padding_top"
            android:paddingBottom="@dimen/login_content_horizontal_margin">

            <TextView
                android:id="@+id/create_account_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/login_title_text_size" />

            <TextView
                android:id="@+id/create_account_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/register_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/login_subtitle_text_size" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/full_name_input"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_input_margin_top"
                android:hint="@string/register_hint_full_name"
                app:boxBackgroundColor="@color/input_background"
                app:boxCornerRadiusBottomEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/login_input_corner_radius"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:errorEnabled="true"
                app:startIconContentDescription="@string/cd_full_name_icon"
                app:startIconDrawable="@drawable/ic_account"
                app:startIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/full_name_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="255"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/mobile_input"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_input_margin_top"
                android:hint="@string/register_hint_mobile"
                app:boxBackgroundColor="@color/input_background"
                app:boxCornerRadiusBottomEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/login_input_corner_radius"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:errorEnabled="true"
                app:startIconContentDescription="@string/cd_mobile_icon"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/mobile_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="20"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/alternate_mobile_input"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_input_margin_top"
                android:hint="@string/register_hint_alternate_mobile"
                app:boxBackgroundColor="@color/input_background"
                app:boxCornerRadiusBottomEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/login_input_corner_radius"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:errorEnabled="true"
                app:startIconContentDescription="@string/cd_alternate_mobile_icon"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/alternate_mobile_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="20"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email_input"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_input_margin_top"
                android:hint="@string/register_hint_email"
                app:boxBackgroundColor="@color/input_background"
                app:boxCornerRadiusBottomEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/login_input_corner_radius"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:errorEnabled="true"
                app:startIconContentDescription="@string/cd_email_icon"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLength="255"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_input"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_input_margin_top"
                android:hint="@string/register_hint_password"
                app:boxBackgroundColor="@color/input_background"
                app:boxCornerRadiusBottomEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/login_input_corner_radius"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:startIconContentDescription="@string/cd_password_icon"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/confirm_password_input"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_input_margin_top"
                android:hint="@string/register_hint_confirm_password"
                app:boxBackgroundColor="@color/input_background"
                app:boxCornerRadiusBottomEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/login_input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/login_input_corner_radius"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:startIconContentDescription="@string/cd_password_icon"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/confirm_password_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/register_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/login_button_height"
                android:layout_marginTop="@dimen/login_input_margin_top"
                android:backgroundTint="@color/primary_blue"
                android:text="@string/register_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/login_subtitle_text_size"
                app:cornerRadius="@dimen/login_button_corner_radius" />

            <ProgressBar
                android:id="@+id/register_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/cd_register_progress"
                android:indeterminateTint="@color/primary_blue"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_divider_margin_vertical"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_already_account"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/login_subtitle_text_size" />

                <TextView
                    android:id="@+id/login_link_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:text="@string/login_button"
                    android:textColor="@color/primary_blue"
                    android:textSize="@dimen/login_subtitle_text_size"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
