<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booking_page_background"
    tools:context=".ui.servicedetails.ServiceDetailsActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/login_header_navy"
        android:paddingHorizontal="@dimen/login_content_horizontal_margin"
        android:paddingTop="@dimen/login_content_horizontal_margin"
        android:paddingBottom="@dimen/home_section_spacing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="@dimen/login_back_button_size"
            android:layout_height="@dimen/login_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/service_details_title"
            android:textColor="@color/white"
            android:textSize="@dimen/login_title_text_size"
            app:layout_constraintBottom_toBottomOf="@id/back_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/back_button"
            app:layout_constraintTop_toTopOf="@id/back_button" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/login_content_horizontal_margin"
            android:paddingTop="@dimen/home_section_spacing"
            android:paddingBottom="@dimen/home_section_spacing">

            <ProgressBar
                android:id="@+id/service_details_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:contentDescription="@string/cd_service_details_progress"
                android:indeterminateTint="@color/primary_blue"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/service_details_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Ticket number + status pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ticket_number_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/login_title_text_size"
                        tools:text="#GS0998" />

                    <TextView
                        android:id="@+id/status_pill_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/primary_blue"
                        android:textSize="@dimen/category_description_text_size"
                        tools:text="In Progress" />

                </LinearLayout>

                <!-- Service Information -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_section_spacing"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/service_details_section_service"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/login_subtitle_text_size" />

                <include
                    android:id="@+id/summary_service_type"
                    layout="@layout/item_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <include
                    android:id="@+id/summary_preferred_date"
                    layout="@layout/item_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_quick_card_spacing" />

                <include
                    android:id="@+id/summary_preferred_time"
                    layout="@layout/item_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_quick_card_spacing" />

                <!-- Product (conditional) -->
                <LinearLayout
                    android:id="@+id/product_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_section_spacing"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/service_details_section_product"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/login_subtitle_text_size" />

                    <include
                        android:id="@+id/summary_product_category"
                        layout="@layout/item_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <include
                        android:id="@+id/summary_product_brand"
                        layout="@layout/item_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_quick_card_spacing" />

                    <include
                        android:id="@+id/summary_product_model"
                        layout="@layout/item_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_quick_card_spacing" />

                    <include
                        android:id="@+id/summary_product_serial"
                        layout="@layout/item_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_quick_card_spacing" />

                </LinearLayout>

                <!-- Complaint -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_section_spacing"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/service_details_section_complaint"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/login_subtitle_text_size" />

                <TextView
                    android:id="@+id/complaint_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_category_card"
                    android:padding="@dimen/category_card_padding"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/category_description_text_size"
                    tools:text="Not Charging" />

                <!-- Service Address (conditional) -->
                <LinearLayout
                    android:id="@+id/address_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_section_spacing"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/service_details_section_address"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/login_subtitle_text_size" />

                    <TextView
                        android:id="@+id/address_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_category_card"
                        android:padding="@dimen/category_card_padding"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/category_description_text_size"
                        tools:text="221B Baker Street, Near Central Park, Coimbatore, Tamil Nadu - 641035" />

                </LinearLayout>

                <!-- Technician (conditional) -->
                <LinearLayout
                    android:id="@+id/technician_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_section_spacing"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/service_details_section_technician"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/login_subtitle_text_size" />

                    <include
                        android:id="@+id/summary_technician_name"
                        layout="@layout/item_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <include
                        android:id="@+id/summary_technician_mobile"
                        layout="@layout/item_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_quick_card_spacing" />

                    <include
                        android:id="@+id/summary_technician_employee_code"
                        layout="@layout/item_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_quick_card_spacing" />

                </LinearLayout>

                <!-- Timeline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_section_spacing"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/service_details_section_timeline"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/login_subtitle_text_size" />

                <LinearLayout
                    android:id="@+id/timeline_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_category_card"
                    android:orientation="vertical"
                    android:padding="@dimen/category_card_padding" />

                <!-- Visit History (conditional) -->
                <LinearLayout
                    android:id="@+id/visits_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_section_spacing"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/service_details_section_visits"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/login_subtitle_text_size" />

                    <LinearLayout
                        android:id="@+id/visits_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
