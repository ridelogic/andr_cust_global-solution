<?xml version="1.0" encoding="utf-8"?>
<!-- Current stage: solid dot plus a lighter outer ring, so it visually stands out from a plain
     completed dot rather than relying on color alone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/banner_subtitle_text" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/primary_blue" />
        </shape>
    </item>
</layer-list>
