<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/splash_bottom_accent" />
            <stroke
                android:width="@dimen/category_card_border_width_selected"
                android:color="@color/primary_blue" />
            <corners android:radius="@dimen/home_quick_card_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="@dimen/category_card_border_width"
                android:color="@color/divider_color" />
            <corners android:radius="@dimen/home_quick_card_corner_radius" />
        </shape>
    </item>
</selector>
